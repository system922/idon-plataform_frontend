{
  "headers": [
    {
      "source": "/static/(js|css)/:file.:hash([a-f0-9]{8}).:ext",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/:path*.(jpg|jpeg|png|webp|gif|ico|svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}