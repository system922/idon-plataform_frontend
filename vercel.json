{
  "builds": [
    {
      "src": "build/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/js/(.*)\\.map$",
      "dest": "/404"
    },
    {
      "src": "/static/css/(.*)\\.map$",
      "dest": "/404"
    },
    {
      "src": "/(.*)\\.map$",
      "dest": "/404"
    },
    {
      "src": "/(.*)",
      "dest": "/build/$1"
    }
  ]
}